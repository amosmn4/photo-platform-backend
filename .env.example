# ==============================================================================
# App identity — the system/app name is always sourced from here, never
# hardcoded anywhere else in the codebase (logs, emails, QR pages all read it).
# ==============================================================================
APP_NAME=PhotoDrop
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000

# Base URL the QR codes point to (the frontend's public gallery route).
PUBLIC_GALLERY_BASE_URL=http://localhost:5173/g

# ==============================================================================
# Database
# ==============================================================================
DATABASE_URL=postgresql://photodrop:photodrop@localhost:5432/photodrop
DB_POOL_MAX=20

# ==============================================================================
# Redis (BullMQ job queue)
# ==============================================================================
REDIS_URL=redis://localhost:6379

# ==============================================================================
# Auth
# ==============================================================================
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_this_with_a_long_random_secret_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
BCRYPT_SALT_ROUNDS=12

# ==============================================================================
# Object storage (S3-compatible). Defaults below match the local MinIO
# service in docker-compose.yml. Point at real AWS S3 / Spaces / B2 in
# staging & production by changing these values only.
# ==============================================================================
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=photodrop-photos
S3_ACCESS_KEY_ID=photodrop_minio
S3_SECRET_ACCESS_KEY=photodrop_minio_secret
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=900

# Optional CDN in front of the bucket (e.g. CloudFront/Cloudflare). Leave
# unset locally.
# CDN_BASE_URL=https://cdn.example.com

# ==============================================================================
# Upload limits
# ==============================================================================
MAX_UPLOAD_FILE_SIZE_BYTES=52428800
MAX_UPLOAD_BATCH_SIZE=20000

# ==============================================================================
# Access tokens / QR
# ==============================================================================
DEFAULT_ACCESS_TOKEN_TTL_DAYS=14

# ==============================================================================
# Rate limiting
# ==============================================================================
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300

LOG_LEVEL=info
