# ==============================================================================
# App identity — the system/app name is always sourced from here, never
# hardcoded anywhere else in the codebase (logs, emails, QR pages all read it).
# ==============================================================================
APP_NAME=PhotoDrop
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000

# Base URL the QR codes point to (the frontend's public gallery route).
PUBLIC_GALLERY_BASE_URL=http://localhost:5173/g

# ==============================================================================
# Database
# ==============================================================================
# POSTGRES_USER/PASSWORD/DB are read by docker-compose.yml to initialize the
# local Postgres container (self-hosted deployments only — ignored if you
# point DATABASE_URL at a managed Postgres instead). Defaults match the
# values below and are fine for local dev; set real values for any shared or
# production box and keep DATABASE_URL's user:password@.../db in sync with
# them, since docker-compose creates the DB user/password and DATABASE_URL is
# what the app and scripts/migrate.ts, scripts/setup-production-db.ts use to
# connect to it.
POSTGRES_USER=photodrop
POSTGRES_PASSWORD=photodrop
POSTGRES_DB=photodrop
DATABASE_URL=postgresql://photodrop:photodrop@localhost:5432/photodrop
DB_POOL_MAX=20

# ==============================================================================
# Redis (BullMQ job queue)
# ==============================================================================
REDIS_URL=redis://localhost:6379

# ==============================================================================
# Auth
# ==============================================================================
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_this_with_a_long_random_secret_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
BCRYPT_SALT_ROUNDS=12

# ==============================================================================
# Object storage (S3-compatible). Defaults below match the local MinIO
# service in docker-compose.yml. Point at real AWS S3 / Spaces / B2 in
# staging & production by changing these values only.
#
# MINIO_ROOT_USER/PASSWORD are read by docker-compose.yml to initialize the
# local MinIO container (self-hosted deployments only). They ARE the MinIO
# credentials, so S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY below must always
# match them exactly — the app authenticates to MinIO with those two values.
# ==============================================================================
MINIO_ROOT_USER=photodrop_minio
MINIO_ROOT_PASSWORD=photodrop_minio_secret
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=photodrop-photos
S3_ACCESS_KEY_ID=photodrop_minio
S3_SECRET_ACCESS_KEY=photodrop_minio_secret
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=900

# Optional CDN in front of the bucket (e.g. CloudFront/Cloudflare). Leave
# unset locally.
# CDN_BASE_URL=https://cdn.example.com

# ==============================================================================
# Outbound email (SMTP) — verification codes today, notifications later.
# Leave SMTP_HOST unset to run without email delivery: outside production the
# verification code is still returned directly in the API response as a dev
# fallback, and every send attempt is logged either way. Works with any SMTP
# provider (SendGrid, Mailgun, Postmark, AWS SES's SMTP interface, a
# self-hosted relay, ...) by changing only these values.
# ==============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=PhotoDrop <no-reply@localhost>

# ==============================================================================
# Upload limits
# ==============================================================================
MAX_UPLOAD_FILE_SIZE_BYTES=52428800
MAX_UPLOAD_BATCH_SIZE=20000

# ==============================================================================
# Access tokens / QR
# ==============================================================================
DEFAULT_ACCESS_TOKEN_TTL_DAYS=14

# ==============================================================================
# Rate limiting
# ==============================================================================
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300

LOG_LEVEL=info
